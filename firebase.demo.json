    "storage": { "host": "127.0.0.1", "port": 9209 },
    "hub": { "host": "127.0.0.1", "port": 4410 },
    "logging": { "host": "127.0.0.1", "port": 4510 },
    "eventarc": { "host": "127.0.0.1", "port": 9310 },

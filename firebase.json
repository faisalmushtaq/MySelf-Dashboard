{
  "firestore": [
    {
      "database": "dashboard",
      "rules": "firestore/dashboard.rules",
      "indexes": "firestore/dashboard.indexes.json"
    }
  ],
  "functions": [
    {
      "source": "functions-bundle",
      "codebase": "dashboard",
      "runtime": "nodejs22",
      "predeploy": ["pnpm --filter @myself-dashboard/core build", "pnpm --filter @myself-dashboard/functions package"]
    }
  ],
  "hosting": [
    {
      "target": "dashboard",
      "public": "apps/web/dist",
      "predeploy": ["pnpm --filter @myself-dashboard/core build", "pnpm --filter @myself-dashboard/web build"],
      "ignore": ["**/.*", "**/*.map"],
      "cleanUrls": true,
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "no-referrer" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
            { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.run.app https://*.firebaseio.com; frame-src 'self' https://*.firebaseapp.com https://*.web.app https://accounts.google.com https://apis.google.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    }
  ]
}

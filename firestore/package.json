{
  "name": "@myself-dashboard/rules-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "echo 'rules tests need the Firestore emulator: pnpm test:rules from the repo root'",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-myself-dashboard --config ../firebase.emulators.json \"vitest run\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

# Copy to apps/functions/.env.<project-id> (e.g. .env.myself-research).
# Non-secret configuration only — the dashboard needs no secrets.
MYSELF_STUDY=ybm
DASHBOARD_DATABASE=dashboard
# Comma-separated browser origins allowed to call the functions.
DASHBOARD_ORIGINS=https://myself-research-dashboard.web.app,https://myself-research-dashboard.firebaseapp.com
# Set to true once App Check is configured for the web app.
DASHBOARD_ENFORCE_APP_CHECK=false

{
  "name": "@myself-dashboard/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:emulator": "vitest run --config vitest.integration.config.ts",
    "test:integration": "firebase emulators:exec --only auth,firestore,storage --project demo-myself-dashboard --config ../../firebase.emulators.json \"vitest run --config vitest.integration.config.ts\"",
    "package": "node build-deploy.mjs"
  },
  "dependencies": {
    "@myself-dashboard/core": "workspace:*",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "pdfkit": "^0.15.2",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.13.9",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
